rules_version = '2';

// Cada pessoa só lê e grava a própria pasta (usuarios/{seu-uid}/...).
// Cole este conteúdo em: Console do Firebase → Firestore Database → Regras → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid}/{documento=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
